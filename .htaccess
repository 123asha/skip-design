# SPA fallback for client-side routing (Apache / Beget).
# Real files and directories (assets, lead.php, etc.) are served as-is;
# every other path falls back to index.html so deep links like /cases work.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One address: https://skip.design — www and plain http are sent there
  RewriteCond %{HTTP_HOST} ^www\.skip\.design$ [NC]
  RewriteRule ^(.*)$ https://skip.design/$1 [R=301,L]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Addresses of the old site (Webflow export) → their new pages, for good
  RewriteRule ^ae-platform-plugin\.html$ /plugin-aliexpress/ [R=301,L]
  RewriteRule ^ae-platform\.html$ /ae-platform/ [R=301,L]
  RewriteRule ^ae-pllatforn-landing\.html$ /aliexpress-landing/ [R=301,L]
  RewriteRule ^room-3d\.html$ /binaroom/ [R=301,L]
  RewriteRule ^(branding|ux-ui|web)\.html$ /services/ [R=301,L]
  RewriteRule ^(crypto-node\.html|special-project/?)$ /cases/ [R=301,L]
  RewriteRule ^information\.html$ / [R=301,L]
  RewriteRule ^policy\.html$ /policy/ [R=301,L]

  # Let existing files and directories through untouched.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → the SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>

# Light caching for hashed assets (safe — filenames change on each build).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png  "access plus 30 days"
  ExpiresByType video/mp4  "access plus 30 days"
  ExpiresByType text/css   "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
